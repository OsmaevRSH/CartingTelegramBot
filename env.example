# Telegram Login: production requires a public HTTPS login domain.
BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_LOGIN_ORIGIN=https://carting.example.com
TELEGRAM_LOGIN_CLIENT_ID=
# JWKS are fetched only when the bounded local cache expires.
TELEGRAM_LOGIN_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
TELEGRAM_LOGIN_JWKS_TIMEOUT_SECONDS=2

# Mobile API authentication
AUTH_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_TTL_SECONDS=2592000

# Настройки базы данных
DATABASE_PATH=data/races.db

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Настройки парсера
PARSER_TIMEOUT=30
PARSER_MAX_RETRIES=3

# Настройки бота
MAX_COMPETITORS_PER_PAGE=10
ENABLE_WEBHOOKS=false
WEBHOOK_URL=
WEBHOOK_PORT=8443
